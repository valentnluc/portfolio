---
interface Props {
  type: string;
}

const { type } = Astro.props;
---

<div class="zen-decoration">
  {
    type === "circles" && (
      <svg class="w-full h-full" viewBox="0 0 200 200">
        <g class="circles-group">
          {[50, 70, 90, 110, 130, 150].map((r, i) => (
            <circle
              cx="100"
              cy="100"
              r={r}
              fill="none"
              stroke="currentColor"
              stroke-width="0.5"
              stroke-dasharray="2,3"
              class="circle-ring"
              style={`animation-delay: ${i * 0.2}s`}
            />
          ))}
          {[0, 45, 90, 135, 180, 225, 270, 315].map((angle, i) => (
            <line
              x1="100"
              y1="100"
              x2={100 + 80 * Math.cos((angle * Math.PI) / 180)}
              y2={100 + 80 * Math.sin((angle * Math.PI) / 180)}
              stroke="currentColor"
              stroke-width="0.5"
              class="circle-ray"
              style={`animation-delay: ${i * 0.1}s`}
            />
          ))}
        </g>
      </svg>
    )
  }

  {
    type === "waves" && (
      <svg class="w-full h-full" viewBox="0 0 200 200">
        {[30, 50, 70, 90, 110, 130, 150, 170].map((y, i) => (
          <g
            class="wave-group"
            style={`animation-delay: ${i * 0.15}s; animation-direction: ${i % 2 ? "normal" : "reverse"}`}
          >
            <path
              d={`M 10 ${y} Q 40 ${y - 10} 70 ${y} T 130 ${y} T 190 ${y}`}
              fill="none"
              stroke="currentColor"
              stroke-width="0.5"
              class="wave-path"
            />
            {Array.from({ length: 15 }).map((_, j) => (
              <circle
                cx={10 + j * 13}
                cy={y}
                r="0.8"
                fill="currentColor"
                class="wave-dot"
              />
            ))}
          </g>
        ))}
      </svg>
    )
  }

  {
    type === "lines" && (
      <svg class="w-full h-full" viewBox="0 0 200 200">
        {Array.from({ length: 12 }).map((_, i) => (
          <g
            class="line-group"
            style={`animation-delay: ${i * 0.1}s; transform-origin: ${20 + i * 14}px 100px`}
          >
            <line
              x1={20 + i * 14}
              y1="40"
              x2={20 + i * 14}
              y2="160"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-dasharray="4,4"
              class="line-dash"
            />
            {Array.from({ length: 9 }).map((_, j) => (
              <text
                x={20 + i * 14}
                y={50 + j * 14}
                font-size="6"
                fill="currentColor"
                text-anchor="middle"
                class="line-char"
                style="font-family: monospace;"
              >
                {i % 2 ? "·" : "|"}
              </text>
            ))}
          </g>
        ))}
      </svg>
    )
  }

  {
    type === "particles" && (
      <svg class="w-full h-full" viewBox="0 0 200 200">
        {Array.from({ length: 30 }).map(() => {
          const x = 30 + Math.random() * 140;
          const y = 30 + Math.random() * 140;
          const size = 2 + Math.random() * 3;
          const char = ["+", "*", "·", "○", "×"][Math.floor(Math.random() * 5)];
          const delay = Math.random() * 2;
          return (
            <g>
              <circle
                cx={x}
                cy={y}
                r={size}
                fill="none"
                stroke="currentColor"
                stroke-width="0.5"
                class="particle-shape"
                style={`animation-delay: ${delay}s; --tx: ${(x - 100) * 0.4}px; --ty: ${(y - 100) * 0.4}px`}
              />
              <text
                x={x}
                y={y + 2}
                font-size="8"
                fill="currentColor"
                text-anchor="middle"
                class="particle-char"
                style={`font-family: monospace; animation-delay: ${delay}s; --tx: ${(x - 100) * 0.5}px; --ty: ${(y - 100) * 0.5}px`}
              >
                {char}
              </text>
            </g>
          );
        })}
      </svg>
    )
  }

  {
    type === "spiral" && (
      <svg class="w-full h-full" viewBox="0 0 200 200">
        <g class="spiral-group">
          <path
            d={`M ${Array.from({ length: 80 })
              .map((_, i) => {
                const angle = (i / 80) * 4 * 2 * Math.PI;
                const radius = 15 + (i / 80) * 70;
                return `${100 + radius * Math.cos(angle)},${100 + radius * Math.sin(angle)}`;
              })
              .join(" L ")}`}
            fill="none"
            stroke="currentColor"
            stroke-width="1"
            stroke-dasharray="3,3"
            class="spiral-path"
          />
          {Array.from({ length: 80 })
            .filter((_, i) => i % 5 === 0)
            .map((_, i) => {
                // Re-calculate points for text since we can't reuse variable in map
                const totalSteps = 80;
                // Since this runs on the filtered array, we need the original index.
                // Re-implement loop logic:
                // Actually filter returns full elements but we need original index.
                // Let's just loop a smaller array and calc based on step size 5.
                 return null;
            })}
             {/* Simplified loop for spiral text points */}
             {Array.from({ length: 16 }).map((_, j) => {
                 const i = j * 5;
                 const angle = (i / 80) * 4 * 2 * Math.PI;
                 const radius = 15 + (i / 80) * 70;
                 const x = 100 + radius * Math.cos(angle);
                 const y = 100 + radius * Math.sin(angle);
                 return (
                    <text
                        x={x}
                        y={y + 2}
                        font-size="7"
                        fill="currentColor"
                        text-anchor="middle"
                        class="spiral-char"
                        style="font-family: monospace;"
                    >
                        {['○', '·', '+', '*'][j % 4]}
                    </text>
                 )
             })}
        </g>
      </svg>
    )
  }
    
    {
    type === "grid" && (
      <svg class="w-full h-full" viewBox="0 0 200 200">
        {Array.from({ length: 10 }).map((_, i) => (
          <g class="grid-group" style={`animation-delay: ${i * 0.1}s`}>
            <line
              x1="30"
              y1={30 + i * 16}
              x2="170"
              y2={30 + i * 16}
              stroke="currentColor"
              stroke-width="0.5"
              stroke-dasharray="2,4"
              class="grid-line"
            />
            <line
              x1={30 + i * 16}
              y1="30"
              x2={30 + i * 16}
              y2="170"
              stroke="currentColor"
              stroke-width="0.5"
              stroke-dasharray="2,4"
              class="grid-line"
            />
            {Array.from({ length: 10 }).map((_, j) => (
              <text
                x={30 + i * 16}
                y={34 + j * 16}
                font-size="6"
                fill="currentColor"
                text-anchor="middle"
                class="grid-char"
                style="font-family: monospace;"
              >
                {(i + j) % 3 === 0 ? "■" : (i + j) % 2 === 0 ? "□" : "·"}
              </text>
            ))}
          </g>
        ))}
        <circle
          cx="100"
          cy="100"
          r="35"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-dasharray="5,5"
          class="grid-circle"
        />
      </svg>
    )
  }

  {
    type === "radar" && (
      <svg class="w-full h-full" viewBox="0 0 200 200">
        <defs>
          <linearGradient id="radarGrad" x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="currentColor" stop-opacity="0" />
            <stop offset="100%" stop-color="currentColor" stop-opacity="0.6" />
          </linearGradient>
        </defs>
        {[40, 60, 80].map((r) => (
          <circle
            cx="100"
            cy="100"
            r={r}
            fill="none"
            stroke="currentColor"
            stroke-width="0.5"
            opacity="0.3"
          />
        ))}
        <g class="radar-sweep">
          <path
            d="M 100 100 L 100 20 A 80 80 0 0 1 180 100 Z"
            fill="url(#radarGrad)"
            class="radar-path"
          />
        </g>
        <circle
          cx="100"
          cy="100"
          r="20"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          class="radar-ping"
        />
      </svg>
    )
  }

  {
    type === "constellation" && (
      <svg class="w-full h-full" viewBox="0 0 200 200">
        <!-- Stars data -->
        {(() => {
            const stars = [
                { x: 50, y: 40 }, { x: 100, y: 30 }, { x: 150, y: 50 },
                { x: 60, y: 90 }, { x: 140, y: 95 }, { x: 45, y: 140 },
                { x: 110, y: 130 }, { x: 155, y: 150 }
            ];
            const connections = [[0,1], [1,2], [0,3], [1,4], [2,4], [3,5], [4,6], [4,7]];
            return (
                <>
                {connections.map((conn, i) => (
                    <line
                        x1={stars[conn[0]].x}
                        y1={stars[conn[0]].y}
                        x2={stars[conn[1]].x}
                        y2={stars[conn[1]].y}
                        stroke="currentColor"
                        stroke-dasharray="2,2"
                        class="constellation-line"
                        style={`animation-delay: ${i * 0.1}s`}
                    />
                ))}
                {stars.map((star, i) => (
                    <g>
                        <circle
                            cx={star.x}
                            cy={star.y}
                            r="3"
                            fill="currentColor"
                            class="constellation-star"
                            style={`animation-delay: ${i * 0.2}s`}
                        />
                        <text
                            x={star.x}
                            y={star.y + 2}
                            font-size="5"
                            fill="currentColor"
                            text-anchor="middle"
                            font-family="monospace"
                            class="constellation-char"
                        >
                            *
                        </text>
                    </g>
                ))}
                </>
            )
        })()}
      </svg>
    )
  }

    {
    type === "hexagons" && (
      <svg class="w-full h-full" viewBox="0 0 200 200">
        {[
          [100, 60], [70, 85], [130, 85],
          [70, 125], [130, 125], [100, 150]
        ].map((pos, i) => (
          <g
            class="hex-group"
            style={`transform-origin: ${pos[0]}px ${pos[1]}px; animation-delay: ${i * 0.15}s`}
          >
            <polygon
              points={`${pos[0]},${pos[1]-15} ${pos[0]+13},${pos[1]-7.5} ${pos[0]+13},${pos[1]+7.5} ${pos[0]},${pos[1]+15} ${pos[0]-13},${pos[1]+7.5} ${pos[0]-13},${pos[1]-7.5}`}
              fill="none"
              stroke="currentColor"
              stroke-width="1"
              class="hex-shape"
            />
            <text
              x={pos[0]}
              y={pos[1] + 3}
              font-size="8"
              fill="currentColor"
              text-anchor="middle"
              font-family="monospace"
              class="hex-char"
            >
              {['⬡', '⬢'][i % 2]}
            </text>
          </g>
        ))}
      </svg>
    )
  }

  {
    type === "matrix" && (
      <svg class="w-full h-full" viewBox="0 0 200 200">
        {Array.from({ length: 15 }).map((_, i) => (
            <g>
                {Array.from({ length: 8 }).map((_, j) => {
                    const chars = ['0', '1', '|', '/', '\\', '-'];
                    return (
                        <text
                            x={15 + i * 13}
                            y={j * 25}
                            font-size="8"
                            fill="currentColor"
                            font-family="monospace"
                            class="matrix-char"
                            style={`animation-delay: ${i * 0.2 + j * 0.3}s`}
                        >
                            {chars[Math.floor((i + j) % chars.length)]}
                        </text>
                    )
                })}
            </g>
        ))}
      </svg>
    )
  }

  {
    type === "breathing" && (
      <svg class="w-full h-full" viewBox="0 0 200 200">
        <g class="breathing-group" style="transform-origin: 100px 100px">
          {[30, 45, 60, 75].map((r, i) => (
            <circle
              cx="100"
              cy="100"
              r={r}
              fill="none"
              stroke="currentColor"
              stroke-width="1"
              stroke-dasharray={`${i * 3},${i * 2}`}
              class="breathing-circle"
              style={`animation-delay: ${i * 0.2}s`}
            />
          ))}
          <circle cx="100" cy="100" r="10" fill="currentColor" opacity="0.5" />
          {Array.from({ length: 8 }).map((_, i) => {
            const angle = (i * 45 * Math.PI) / 180;
            return (
              <text
                x={100 + 50 * Math.cos(angle)}
                y={100 + 50 * Math.sin(angle) + 3}
                font-size="10"
                fill="currentColor"
                text-anchor="middle"
                font-family="monospace"
                opacity="0.4"
              >
                ·
              </text>
            );
          })}
        </g>
      </svg>
    )
  }

  {
    type === "binary" && (
      <svg class="w-full h-full" viewBox="0 0 200 200">
        {/* Simplified static binary clock simulation for visual effect */}
         {/* Hours */}
         <g transform="translate(40, 80)">
             {['1','0','1','0','1'].map((bit, i) => (
                 <g class="binary-bit">
                     <rect x={i*20} y="0" width="15" height="15" fill={bit === '1' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="0.5" class="binary-rect" style={`animation-delay: ${i*0.1}s`}/>
                     <text x={i*20 + 7.5} y="12" font-size="8" fill={bit === '1' ? 'white' : 'currentColor'} text-anchor="middle" font-family="monospace" opacity="0.8">{bit}</text>
                 </g>
             ))}
         </g>
         {/* Minutes */}
         <g transform="translate(35, 110)">
             {['1','1','0','0','1','0'].map((bit, i) => (
                 <g class="binary-bit">
                     <rect x={i*18} y="0" width="13" height="13" fill={bit === '1' ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="0.5" class="binary-rect" style={`animation-delay: ${i*0.1}s`}/>
                     <text x={i*18 + 6.5} y="10" font-size="7" fill={bit === '1' ? 'white' : 'currentColor'} text-anchor="middle" font-family="monospace" opacity="0.8">{bit}</text>
                 </g>
             ))}
         </g>
         <text x="100" y="50" font-size="10" fill="currentColor" text-anchor="middle" font-family="monospace" opacity="0.4">binary clock</text>
      </svg>
    )
  }
</div>

<style>
  .zen-decoration {
    width: 100%;
    height: 100%;
    color: var(--white); /* Default color */
    opacity: 0.3;
    transition: all 0.5s ease;
  }

  /* Container hover interaction (handled by parent or inherent) */
  :global(.bento-cell:hover) .zen-decoration {
    opacity: 0.8;
  }
  
  /* Color transition on hover */
  :global(.bento-cell:hover) .zen-decoration {
      color: var(--blue);
  }
  /* Specific elements red/blue split */
  :global(.bento-cell:hover) .zen-decoration svg {
      filter: drop-shadow(0 0 1px var(--red));
  }

  /* Animations */
  @keyframes rotate-slow { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes rotate-fast { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes pulse { 0%, 100% { opacity: 0.3; } 50% { opacity: 0.6; } }
  @keyframes pulse-fast { 0%, 100% { opacity: 0.5; } 50% { opacity: 1; } }
  
  /* Circles */
  .circles-group {
      transform-origin: 100px 100px;
      animation: rotate-slow 12s linear infinite;
  }
  :global(.bento-cell:hover) .circles-group {
      animation: rotate-fast 3s linear infinite;
  }
  
  .circle-ring, .circle-ray {
      transition: opacity 0.8s ease;
      animation: pulse 3s ease-in-out infinite;
  }
  :global(.bento-cell:hover) .circle-ring,
  :global(.bento-cell:hover) .circle-ray {
      opacity: 0.8 !important;
      animation: pulse-fast 1s ease-in-out infinite;
  }

  /* Waves */
  @keyframes wave-move { 0% { transform: translateX(0); } 100% { transform: translateX(-20px); } }
  @keyframes wave-fast { 0% { transform: translateX(0) scaleY(1); } 100% { transform: translateX(-40px) scaleY(1.3); } }
  
  .wave-group {
      animation: wave-move 8s ease-in-out infinite;
  }
  :global(.bento-cell:hover) .wave-group {
      animation: wave-fast 2s ease-in-out infinite;
  }

  /* Lines */
  @keyframes line-float { 0%, 100% { transform: translateY(0) scaleY(1); } 50% { transform: translateY(-8px) scaleY(0.95); } }
  @keyframes line-bounce { 0%, 100% { transform: translateY(0) scaleY(1); } 50% { transform: translateY(-20px) scaleY(0.6); } }
  
  .line-group {
      animation: line-float 4s ease-in-out infinite;
  }
  :global(.bento-cell:hover) .line-group {
      animation: line-bounce 1.5s ease-in-out infinite;
  }

  /* Particles */
  @keyframes float { 
      0%, 100% { transform: translate(0, 0); } 
      25% { transform: translate(3px, -4px); }
      50% { transform: translate(-2px, 2px); }
      75% { transform: translate(4px, 3px); }
  }
  @keyframes scatter { 
      0% { transform: translate(0, 0) scale(1); } 
      100% { transform: translate(var(--tx), var(--ty)) scale(1.8); } 
  }
  
  .particle-shape, .particle-char {
      animation: float 6s ease-in-out infinite;
  }
  :global(.bento-cell:hover) .particle-shape,
  :global(.bento-cell:hover) .particle-char {
      animation: scatter 2s ease-out infinite;
  }

  /* Spiral */
  @keyframes spiral-slow { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes spiral-fast { from { transform: rotate(0deg) scale(1); } to { transform: rotate(720deg) scale(0.6); } }
  .spiral-group {
      transform-origin: 100px 100px;
      animation: spiral-slow 20s linear infinite;
  }
  :global(.bento-cell:hover) .spiral-group {
      animation: spiral-fast 4s linear infinite;
  }

  /* Grid */
  @keyframes grid-drift { 
      0%, 100% { transform: translate(0, 0); } 
      50% { transform: translate(5px, 5px); } 
  }
  @keyframes grid-shake { 
      0%, 100% { transform: translate(0, 0); } 
      25% { transform: translate(-10px, 8px); }
      75% { transform: translate(8px, -10px); }
  }
  @keyframes circle-grow { 
      from { transform: scale(1) rotate(0deg); } 
      to { transform: scale(1.8) rotate(360deg); } 
  }
  
  .grid-group {
      animation: grid-drift 8s ease-in-out infinite;
  }
  :global(.bento-cell:hover) .grid-group {
      animation: grid-shake 1.5s ease-in-out infinite;
  }
  :global(.bento-cell:hover) .grid-circle {
      animation: circle-grow 3s ease-in-out infinite;
      transform-origin: 100px 100px;
  }

  /* Radar */
  @keyframes radar-sweep { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @keyframes radar-fast { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  
  .radar-sweep {
      transform-origin: 100px 100px;
      animation: radar-sweep 8s linear infinite;
  }
  :global(.bento-cell:hover) .radar-sweep {
      animation: radar-fast 2s linear infinite;
  }
  
  .radar-ping {
      opacity: 0.8;
  }
  :global(.bento-cell:hover) .radar-ping {
      animation: pulse 0.5s infinite;
  }

  /* Constellation */
  @keyframes twinkle { 0%, 100% { opacity: 0.3; } 50% { opacity: 0.8; } }
  @keyframes twinkle-fast { 0%, 100% { opacity: 0.5; } 50% { opacity: 1; } }
  @keyframes line-glow { 0%, 100% { stroke-width: 0.5; opacity: 0.2; } 50% { stroke-width: 1.5; opacity: 0.5; } }
  
  .constellation-star {
      animation: twinkle 3s ease-in-out infinite;
  }
  :global(.bento-cell:hover) .constellation-star {
      animation: twinkle-fast 1.2s ease-in-out infinite;
  }
  :global(.bento-cell:hover) .constellation-line {
      animation: line-glow 1s ease-in-out infinite;
  }

  /* Hexagons */
  @keyframes hex-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-5px); } }
  @keyframes hex-expand { 0%, 100% { transform: scale(1) rotate(0deg); } 50% { transform: scale(1.3) rotate(180deg); } }
  
  .hex-group {
      animation: hex-float 4s ease-in-out infinite;
  }
  :global(.bento-cell:hover) .hex-group {
      animation: hex-expand 2s ease-in-out infinite;
  }

  /* Matrix */
  @keyframes matrix-fall { from { transform: translateY(-20px); opacity: 0; } to { transform: translateY(180px); opacity: 0; } }
  @keyframes matrix-fast { from { transform: translateY(-20px); opacity: 0; } to { transform: translateY(180px); opacity: 0; } }
  
  .matrix-char {
      opacity: 0.4;
      animation: matrix-fall 6s linear infinite;
  }
  :global(.bento-cell:hover) .matrix-char {
      animation: matrix-fast 1.5s linear infinite;
  }

  /* Breathing */
  @keyframes breathe { 
      0%, 100% { transform: scale(0.8); opacity: 0.3; } 
      50% { transform: scale(1.1); opacity: 0.6; } 
  }
  @keyframes breathe-fast { 
      0%, 100% { transform: scale(0.6); opacity: 0.5; } 
      50% { transform: scale(1.4); opacity: 0.9; } 
  }
  
  .breathing-group {
      animation: breathe 5s ease-in-out infinite;
  }
  :global(.bento-cell:hover) .breathing-group {
      animation: breathe-fast 2s ease-in-out infinite;
  }

  /* Binary */
  @keyframes blink { 0%, 49% { opacity: 0.8; } 50%, 100% { opacity: 0.3; } }
  @keyframes blink-fast { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0.2; } }
  
  .binary-rect {
      /* Animation handled inline/conditionally if separate classes used, but here simpler */
  }
  :global(.bento-cell:hover) .binary-rect {
     /* Can't easily target "active" bits without JS or complex CSS selectors if structure flat. 
        For now simple opacity pulse on group */
  }

</style>
