---
import BaseLayout from "../layouts/BaseLayout.astro";
import GridItem from "../components/GridItem.astro";
import { getCollection } from "astro:content";

// Get blog posts sorted by order (only 4 blogs)
const blogs = await getCollection("projects");
const sortedBlogs = blogs.sort((a, b) => a.data.order - b.data.order).slice(0, 4);

// Zen decorations list
const zenDecorations = [
  "lines",
  "grid",
  "waves",
  "circles",
  "waves",
  "particles",
  "spiral",
  "grid",
  "constellation",
  "hexagons",
  "matrix",
  "breathing",
];

// Prepare blog data (no markdown parse needed — content lives in /projects/[slug])
const blogItems = sortedBlogs.map((blog, i) => ({
  type: "blog" as const,
  data: {
    ...blog.data,
    slug: blog.slug,
    decoration: zenDecorations[i % zenDecorations.length],
  },
}));

// Static cells
const nameCell = {
  type: "name" as const,
  data: {
    firstName: "VALENTIN",
    lastName: "LUCARINI",
    subtitle: "Analista de gestion",
  },
};

const socialCell = {
  type: "social" as const,
  data: {
    linkedin: "https://www.linkedin.com/in/valentinlucarini/",
    github: "https://github.com/valentnluc",
    email: "valentn.luc@gmail.com",
    x: "https://x.com/valentin",
  },
};

// Open To Work cell
const openToWorkCell = {
  type: "opentowork" as const,
  data: {},
};

// About cell
const aboutCell = {
  type: "about" as const,
  data: {
    text: "Analista de gestión en construcción. Integro programación, finanzas y análisis de datos para optimizar procesos y tomar decisiones más rápidas y precisas en entornos de obra.",
  },
};

// Projects cell
const projectsCell = {
  type: "project" as const,
  data: {},
};

// Wide cell (spans 3 columns)
const wideCell = {
  type: "stack" as const,
  data: {},
};

// Build 4x3 grid (12 cells)
// Row 1: name, otw, about, project
// Row 2: blog0, blog1, blog2, blog3
// Row 3: wideCell (spans 3), social
const gridCells = [
  nameCell,        // 0
  openToWorkCell,  // 1
  aboutCell,       // 2
  projectsCell,    // 3

  blogItems[0],    // 4
  blogItems[1],    // 5
  blogItems[2],    // 6
  blogItems[3],    // 7

  wideCell,        // 8 (spans 3)
  socialCell,      // 9
];
---

<BaseLayout title="Valentin Lucarini." description="Analista de gestión — Portfolio de proyectos de finanzas, construcción y análisis de datos.">
  <main class="bento-grid">
    {
      gridCells.map((cell, index) => (
        <GridItem type={cell.type} data={cell.data} index={index} />
      ))
    }
  </main>

  <!-- ASCII Scramble + OTW Theme + Sequential Hover -->
  <script>
    // ── ASCII Scramble on name cell ───────────────────────────────
    const CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%&*!?<>[]{}";

    function scrambleText(element: HTMLElement, originalText: string) {
      let iteration = 0;
      const interval = setInterval(() => {
        element.textContent = originalText
          .split("")
          .map((char, index) => {
            if (char === " ") return " ";
            if (index < iteration) return originalText[index];
            return CHARS[Math.floor(Math.random() * CHARS.length)];
          })
          .join("");

        iteration += 1 / 3;
        if (iteration >= originalText.length) {
          element.textContent = originalText;
          clearInterval(interval);
        }
      }, 30);

      return interval;
    }

    const nameCell = document.querySelector(".bento-cell.cell-name");
    const nameFirst = document.querySelector(".name-first") as HTMLElement;
    const nameLast = document.querySelector(".name-last") as HTMLElement;
    const nameSubtitle = document.querySelector(".name-subtitle") as HTMLElement;

    if (nameCell && nameFirst && nameLast && nameSubtitle) {
      const originalFirst = nameFirst.textContent || "";
      const originalLast = nameLast.textContent || "";
      const originalSubtitle = nameSubtitle.textContent || "";

      let firstInterval: number;
      let lastInterval: number;
      let subtitleInterval: number;

      nameCell.addEventListener("mouseenter", () => {
        firstInterval = scrambleText(nameFirst, originalFirst);
        lastInterval = scrambleText(nameLast, originalLast);
        subtitleInterval = scrambleText(nameSubtitle, originalSubtitle);
      });

      nameCell.addEventListener("mouseleave", () => {
        clearInterval(firstInterval);
        clearInterval(lastInterval);
        clearInterval(subtitleInterval);
        nameFirst.textContent = originalFirst;
        nameLast.textContent = originalLast;
        nameSubtitle.textContent = originalSubtitle;
      });
    }

    // ── Open To Work Theme Toggle ─────────────────────────────────
    const otwCell = document.querySelector(".cell-opentowork");
    if (otwCell) {
      otwCell.addEventListener("mouseenter", () => {
        document.body.classList.add("theme-green");
      });
      otwCell.addEventListener("mouseleave", () => {
        document.body.classList.remove("theme-green");
      });
    }

    // ── Sequential pulse on project cell hover ────────────────────
    const projectCell = document.querySelector(".cell-project");
    const blogCells = Array.from(document.querySelectorAll('[data-type="blog"]'));

    let pulseInterval: number | null = null;
    let pulseIndex = 0;

    function startSequentialPulse() {
      stopSequentialPulse();
      pulseIndex = 0;
      blogCells[0]?.classList.add("blog-pulsed");

      pulseInterval = window.setInterval(() => {
        blogCells[pulseIndex]?.classList.remove("blog-pulsed");
        pulseIndex++;
        
        if (pulseIndex >= blogCells.length) {
          stopSequentialPulse();
        } else {
          blogCells[pulseIndex]?.classList.add("blog-pulsed");
        }
      }, 350);
    }

    function stopSequentialPulse() {
      if (pulseInterval !== null) {
        clearInterval(pulseInterval);
        pulseInterval = null;
      }
      blogCells.forEach((c) => c.classList.remove("blog-pulsed"));
    }

    if (projectCell) {
      projectCell.addEventListener("mouseenter", startSequentialPulse);
      projectCell.addEventListener("mouseleave", stopSequentialPulse);
    }
  </script>
</BaseLayout>
